---
import { timeline, scopeTracePoints, ewmaTracePoints } from '../data/timeline';
---

<section aria-labelledby="load-h" class="path">
  <div class="inner">
    <div class="heading-row">
      <h2 id="load-h">01 / The path so far, since 2010</h2>
      <div class="legend">
        <span class="legend-item"><span class="swatch swatch-scope"></span>Scope</span>
        <span class="legend-item"><span class="swatch swatch-trend"></span>Trend</span>
      </div>
    </div>

    <div class="chart">
      <svg viewBox="0 0 1200 230" preserveAspectRatio="none" aria-hidden="true" class="chart-svg">
        <path class="sl-trace" d={scopeTracePoints} fill="none" stroke="#121416" stroke-width="1.2" vector-effect="non-scaling-stroke"></path>
        <path class="sl-ewma" d={ewmaTracePoints} fill="none" stroke="var(--color-accent)" stroke-width="3" vector-effect="non-scaling-stroke"></path>
      </svg>
      {timeline.map((m) => (
        <span
          class={`dot ${m.current ? 'dot-current' : ''}`}
          style={`left: ${m.dot.left}; top: ${m.dot.top};`}
        >
          {m.index}
        </span>
      ))}
    </div>

    <ol class="milestones">
      {timeline.map((m) => (
        <li>
          <span class={`index ${m.current ? 'index-current' : ''}`}>{m.index} · {m.year}</span>
          <span class="title">{m.title}</span>
          <span class="org">{m.org}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .path {
    border-top: 1px solid var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
    background: var(--color-surface-alt);
  }
  .inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-7) var(--space-5) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .heading-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }
  h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .legend {
    display: flex;
    gap: 20px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .swatch {
    width: 18px;
    height: 2px;
    background: var(--color-ink);
  }
  .swatch-trend {
    height: 3px;
    background: var(--color-accent);
  }

  .chart {
    position: relative;
    height: 240px;
    border-bottom: 1px solid var(--color-ink);
  }
  .chart-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .dot {
    position: absolute;
    transform: translate(-50%, -140%);
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-ink);
    color: var(--color-paper);
    font: 500 11px/22px var(--font-mono);
    text-align: center;
  }
  .dot:first-child {
    transform: translate(-2px, -50%);
  }
  .dot-current {
    background: var(--color-accent);
    color: var(--color-ink);
  }

  .milestones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr));
    gap: 20px 24px;
  }
  .milestones li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .index {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
  }
  .index-current {
    color: var(--color-accent-hover);
  }
  .title {
    font-weight: 600;
    line-height: 1.3;
  }
  .org {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.35;
  }
</style>
