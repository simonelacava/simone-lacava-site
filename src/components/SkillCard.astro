---
import type { Skill } from '../data/skills';

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
---

<article class:list={['card', { inverted: skill.inverted }]}>
  <span class="letter">{skill.letter}</span>
  <h3>{skill.title}</h3>
  <p>{skill.body}</p>
</article>

<style>
  .card {
    padding: 32px 32px 32px 0;
    border-bottom: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .card:not(:first-child) {
    padding: 32px;
  }
  .letter {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-card-letter);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-ink);
  }
  h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
  }
  p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 16px;
  }
  .inverted {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .inverted .letter {
    color: var(--color-accent);
    -webkit-text-stroke: 0;
  }
  .inverted p {
    color: var(--color-border);
  }
</style>
