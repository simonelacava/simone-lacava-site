---
import { trackRecord } from '../data/trackRecord';
import TrackRecordEntry from './TrackRecordEntry.astro';
---

<section id="work" aria-labelledby="work-h" class="work">
  <div class="inner">
    <div class="heading-row">
      <div class="heading">
        <p class="eyebrow">04 / Selected work</p>
        <h2 id="work-h">Track record</h2>
      </div>
      <a href="#contact" class="cv-link">Full CV on request →</a>
    </div>

    <div class="entries">
      {trackRecord.map((entry) => <TrackRecordEntry entry={entry} />)}
    </div>
  </div>
</section>

<style>
  .work {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-10) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .heading-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-4);
  }
  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-border);
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-section-h);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .cv-link {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-paper);
    padding: 12px 0;
  }
  .entries {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border-dark);
  }
</style>
