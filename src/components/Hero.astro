---
import { Image } from 'astro:assets';
import simone from '../assets/images/simone.png';
---

<section id="top" class="hero">
  <div class="intro">
    <p class="eyebrow">Product Manager · Data products · AI-native · London</p>
    <h1>I turn complex data into tools <span class="accent">experts actually use.</span></h1>
    <p class="lede">
      I started as a sports scientist, translating GPS data for coaches. Since then I've led
      products in performance analytics, broadcast and media tech, and statistical research. In
      every field the job is the same. Understand the specialist, simplify the data and ship what
      works. I also prototype in code with AI, so ideas get tested with users before engineering
      commits a sprint.
    </p>
    <div class="actions">
      <a class="sl-btn btn btn-ink" href="mailto:simone.lacava@gmail.com">
        Get in touch
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4"></path>
        </svg>
      </a>
      <a class="sl-btn btn btn-outline" href="#work">See the work</a>
    </div>
  </div>

  <figure class="portrait">
    <div class="frame">
      <Image class="sl-photo" src={simone} alt="Portrait of Simone Lacava" width={360} height={396} />
    </div>
    <figcaption class="facts">
      <div class="fact">
        <span class="label">Base</span><span>London</span>
      </div>
      <div class="fact">
        <span class="label">Zone</span><span>GMT</span>
      </div>
      <div class="fact">
        <span class="label">Speaks</span><span>IT · EN · ES</span>
      </div>
    </figcaption>
  </figure>
</section>

<style>
  .hero {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-9) var(--space-5) var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: 48px 64px;
    align-items: flex-end;
  }
  .intro {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-hero);
    line-height: 0.88;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .accent {
    color: var(--color-accent);
  }
  .lede {
    margin: 0;
    max-width: 640px;
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.5;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: 4px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 22px;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
  }
  .btn-ink {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .btn-outline {
    border: 1.5px solid var(--color-ink);
    color: var(--color-ink);
  }

  .portrait {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    flex: 1 1 280px;
    max-width: 360px;
  }
  .frame {
    position: relative;
    background: var(--color-accent);
    aspect-ratio: 4 / 4.4;
    overflow: hidden;
  }
  .frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    mix-blend-mode: multiply;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--color-ink);
    border-top: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .fact {
    padding: 10px 12px;
    border-right: 1px solid var(--color-ink);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .fact:last-child {
    border-right: 0;
  }
  .fact .label {
    color: var(--color-muted);
  }
</style>
